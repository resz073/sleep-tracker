{
  "appId": "com.resz073.sleeptracker",
  "appName": "Sleep Tracker",
  "webDir": "www",
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DEFAULT"
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": ["google.com"]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_moon",
      "iconColor": "#4D52CF"
    }
  }
}
