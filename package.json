{
  "name": "sleep-tracker",
  "version": "1.1.0",
  "private": true,
  "description": "Sleep Tracker for Android: two-tap sleep logging, sleep debt, trends and an automatic bedtime schedule.",
  "type": "module",
  "scripts": {
    "config": "node scripts/write-config.mjs",
    "build": "node scripts/build-web.mjs",
    "android": "npx cap add android && node scripts/patch-android.mjs && npx cap sync android",
    "icons": "node scripts/patch-android.mjs --preview"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "firebase": "^12.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@fontsource/nunito": "^5.0.0",
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=22"
  }
}
