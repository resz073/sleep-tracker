<?xml version="1.0" encoding="utf-8"?>
<!-- The home screen widget: the app's night-sky card in small (SleepWidget fills in the text) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="12dp"
    android:paddingRight="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/w_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="Bedtime tonight"
        android:textColor="@color/widget_mute"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_big"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="–"
        android:textColor="@color/widget_ink"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/w_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:textColor="@color/widget_mute"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/w_debt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/widget_mute"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/w_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_button"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:text="Going to sleep"
        android:textColor="@color/widget_on_button"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
