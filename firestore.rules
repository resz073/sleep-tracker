rules_version = '2';

// Each person can read and write only their own document: users/{their user id}.
// Nobody else, including other signed-in users, can see it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
